#!/usr/bin/env python3
"""Bench Tested launcher - finds the app's files and starts it."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for path in (here, os.path.expanduser("~/.local/share/bench-tested/lib")):
    if os.path.isdir(os.path.join(path, "benchtested")):
        sys.path.insert(0, path)
        break

from benchtested.app import main  # noqa: E402

main()

        # ============================================================ printer list
        def refresh_devices(self):
            devs = scan_usb()
            sig = [(d["key"], d["lp"]) for d in devs]
            if sig != self.dev_sig:
                first_time = self.dev_sig is None
                self.dev_sig = sig
                self.devices = devs
                self.rebuild_rows()
                if not first_time:
                    self.in_thread(self.forget_unplugged_units)

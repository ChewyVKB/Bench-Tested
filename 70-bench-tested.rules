# Bench Tested: give the logged-in user access to the devices it tests.
# (uaccess = only the person sitting at the computer, only while they're logged in)

# Dictation mics - their buttons often arrive as raw HID reports
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0554", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0911", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="07b4", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="df04", TAG+="uaccess"

# Topaz signature pads (serial "BSB" models use an FTDI chip with a TOPAZ serial number)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="TOPAZ*", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="eSign*", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="06a8", TAG+="uaccess"

# Zebra label printers - lets the app "replug" a printer in software when its USB
# connection doesn't come back after a factory reset or calibration
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0a5f", TAG+="uaccess"
